# API base URL.
# Leave empty in Docker/same-origin production builds so the app uses /api.
# Use http://localhost:3001/api for local Vite development if needed.
VITE_API_URL=

# Supabase auth (optional).
# Leave blank to use the backend JWT login flow.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Development-only demo shortcuts.
VITE_ALLOW_DEMO_AUTH=false

# OAuth buttons.
VITE_ENABLE_GOOGLE_OAUTH=false
VITE_ENABLE_APPLE_OAUTH=false
