# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Build output (generated — not committed)
frontend/dist/
backend/public/

# Database files
backend/data/*.db
backend/data/*.db-*
backend/data/*.sqlite
backend/data/*.sqlite3
backend/data/*.db-wal
backend/data/*.db-shm
backend/*.db
*.db

# Uploads (user content)
backend/uploads/*
!backend/uploads/.gitkeep

# Environment (never commit secrets)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env.local
frontend/.env.development
frontend/.env.production
frontend/.env.production.local
frontend/.env.*
!frontend/.env.example

# Backups
backups/

# OS & editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs
*.log
npm-debug.log*
